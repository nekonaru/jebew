# Connection string Postgres dari Supabase project final.
# Jangan pernah commit nilai asli variabel ini.
DATABASE_URL=postgresql://postgres.[PROYEK]:[KATA_SANDI]@[HOST]:6543/postgres

# Rahasia untuk menandatangani cookie sesi. Wajib diisi di produksi.
RAHASIA_SESI=ganti-dengan-string-acak-yang-panjang

# Nomor WhatsApp admin dalam format internasional tanpa tanda plus.
WHATSAPP_ADMIN=6282173282591

# Verifikasi sertifikat TLS database. Set false hanya bila proksi lokal memakai sertifikat mandiri.
DATABASE_TLS_VERIFY=true

# Hanya untuk database uji: mengizinkan npm run bersih:laju menghapus pembatasan laju.
# Jangan diset pada produksi.
IZINKAN_HAPUS_LAJU=

# Nama usaha diatur lewat halaman Pengaturan, bukan variabel lingkungan.
