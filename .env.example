# Connection string Postgres dari Supabase, panel Database, menu Connection string.
# Pakai URI dengan pools transaction bila tersedia. Jangan pernah commit nilai ini.
DATABASE_URL=postgresql://postgres.[PROYEK]:[KATA_SANDI]@[HOST]:6543/postgres

# PIN untuk masuk ke dashboard admin. Wajib diisi di produksi.
ADMIN_PIN=ganti-dengan-pin-anda

# Rahasia untuk menandatangani cookie sesi. Pakai string acak panjang. Wajib diisi di produksi.
RAHASIA_SESI=ganti-dengan-string-acak-yang-panjang

# Nomor WhatsApp admin dalam format internasional tanpa tanda plus, contoh 6281234567890.
WHATSAPP_ADMIN=6281234567890

# Nama usaha yang tampil di pesan WhatsApp.
NAMA_USAHA=Mie Jebew
